                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                            <TextBlock Text="ReTray · " Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
                            <TextBlock x:Name="AppVersionText" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            </Grid>
            </Border>
        </Grid>
        <Image x:Name="WindowTransitionSnapshot"
