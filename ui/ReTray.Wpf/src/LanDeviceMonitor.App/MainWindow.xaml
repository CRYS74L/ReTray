                                    <TextBox controls:InputPlaceholder.Text="HH:mm" x:Name="DoNotDisturbEndBox" Grid.Column="3" Width="96" Height="44" Padding="12,0" VerticalContentAlignment="Center" MaxLength="5" TextAlignment="Center" AutomationProperties.Name="免打扰结束时间" TextChanged="AppBehaviorSetting_Changed"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,5"/>
