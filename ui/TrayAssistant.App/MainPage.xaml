<Page x:Class="TrayAssistant_App.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:TrayAssistant_App.Models" Loaded="Page_Loaded" SizeChanged="Page_SizeChanged">
 <Page.Resources><Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/></Style></Page.Resources>
 <NavigationView x:Name="Nav" PaneDisplayMode="Left" OpenPaneLength="196" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="Nav_SelectionChanged" Header="">
  <NavigationView.MenuItems>
   <NavigationViewItem Content="托盘图标" Tag="icons" Icon="ViewAll" IsSelected="True"/>
   <NavigationViewItem Content="窗口收起" Tag="windows" Icon="Switch"/>
   <NavigationViewItem Content="偏好设置" Tag="settings" Icon="Setting"/>
   <NavigationViewItem Content="运行状态" Tag="diagnostics" Icon="Help"/>
  </NavigationView.MenuItems>
  <Grid Margin="24,8,24,24" RowSpacing="16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Spacing="6"><TextBlock x:Name="PageHeading" Text="你的托盘，由你整理" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="藏好不常用的图标，留下你想看见的。" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
   <Grid x:Name="IconsView" Grid.Row="1" RowSpacing="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><AutoSuggestBox PlaceholderText="搜索程序或提示" Text="{x:Bind Vm.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" QueryIcon="Find" AutomationProperties.Name="搜索托盘图标"/><Button Grid.Column="1" Content="撤销" Command="{x:Bind Vm.UndoCommand}"/></Grid>
    <Grid Grid.Row="1" ColumnSpacing="20" x:Name="MasterDetail"><Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="330"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="{x:Bind Vm.CountLabel, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
      <ListView x:Name="IconList" Grid.Row="1" ItemsSource="{x:Bind Vm.Icons, Mode=OneWay}" SelectedItem="{x:Bind Vm.Selected, Mode=TwoWay}" SelectionMode="Single" CanDragItems="True" CanReorderItems="True" AllowDrop="True" DragItemsCompleted="IconList_DragItemsCompleted" AutomationProperties.Name="实际托盘图标列表">
       <ListView.ItemTemplate><DataTemplate x:DataType="models:IconRow"><Grid Padding="4,10" ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{x:Bind Image, Mode=OneWay}" Width="28" Height="28"/><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Tip, Mode=OneWay}" MaxLines="1" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind State, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate>
      </ListView>
     </Grid>
     <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="16">
      <Border Style="{StaticResource Card}"><StackPanel Spacing="14">
       <TextBlock Text="{x:Bind Vm.Selected.Name, Mode=OneWay, FallbackValue=选择一个图标}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Vm.Selected.Identity, Mode=OneWay, FallbackValue=查看和调整显示方式}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Spacing="8"><Image Source="{x:Bind Vm.Selected.Original, Mode=OneWay, FallbackValue={x:Null}}" Width="48" Height="48"/><TextBlock Text="原应用图像" HorizontalAlignment="Center" FontSize="12"/></StackPanel><StackPanel Grid.Column="1" Spacing="8"><Image Source="{x:Bind Vm.Selected.Image, Mode=OneWay, FallbackValue={x:Null}}" Width="48" Height="48"/><TextBlock Text="当前显示" HorizontalAlignment="Center" FontSize="12"/></StackPanel></Grid>
       <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="打开原菜单" Command="{x:Bind Vm.OriginalMenuCommand}"/><Button Content="打开程序" Command="{x:Bind Vm.OpenIconCommand}"/></StackPanel>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel Spacing="14">
       <TextBlock Text="图标外观" FontSize="18" FontWeight="SemiBold"/>
       <TextBox Header="替代图标" Text="{x:Bind Vm.Asset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" PlaceholderText="使用原应用图标"/><Button Content="选择 ICO、图片或程序图标…" Command="{x:Bind Vm.ChooseIconCommand}" HorizontalAlignment="Left"/>
       <TextBlock Text="消息提醒与闪烁继续交给原应用。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <TextBox Header="自定义提示" PlaceholderText="留空使用原提示" MaxLength="127" Text="{x:Bind Vm.Tip, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
       <ComboBox Header="可见性" SelectedIndex="{x:Bind Vm.VisibilityIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"><x:String>跟随原应用</x:String><x:String>显示</x:String><x:String>完全隐藏</x:String></ComboBox>
       <ComboBox Header="显示位置" SelectedIndex="{x:Bind Vm.LocationIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"><x:String>保持原位置</x:String><x:String>任务栏</x:String><x:String>折叠区</x:String></ComboBox>
       <NumberBox Header="原生位置序号（-1 保持）" Minimum="-1" Maximum="255" Value="{x:Bind Vm.Order, Mode=TwoWay}" SpinButtonPlacementMode="Inline"/>
       <Expander Header="活动与菜单规则" HorizontalAlignment="Stretch"><StackPanel Spacing="14"><NumberBox Header="不活动后隐藏（秒，0 关闭）" Minimum="0" Maximum="86400" Value="{x:Bind Vm.InactiveSeconds, Mode=TwoWay}"/><NumberBox Header="长期未访问后隐藏（天，0 关闭）" Minimum="0" Maximum="3650" Value="{x:Bind Vm.UnusedDays, Mode=TwoWay}"/><ToggleSwitch Header="始终显示，忽略活动隐藏" IsOn="{x:Bind Vm.AlwaysShow, Mode=TwoWay}"/><ToggleSwitch Header="在助手快捷菜单中显示" IsOn="{x:Bind Vm.MenuVisible, Mode=TwoWay}"/></StackPanel></Expander>
       <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="保存并应用" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.SaveRuleCommand}"/><Button Content="恢复原设置" Command="{x:Bind Vm.ResetRuleCommand}"/></StackPanel>
      </StackPanel></Border>
     </StackPanel></ScrollViewer>
    </Grid>
   </Grid>
   <ScrollViewer x:Name="WindowsView" Grid.Row="1" Visibility="Collapsed"><StackPanel Spacing="18"><Border Style="{StaticResource Card}"><StackPanel Spacing="16"><TextBlock Text="为窗口留一个安静的位置" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Win + Alt + M 收起当前窗口；Ctrl + Alt + T 打开助手。" TextWrapping="Wrap"/><TextBlock Text="{x:Bind Vm.WindowsStatus, Mode=OneWay}" TextWrapping="Wrap"/><Button Content="恢复所有窗口" Command="{x:Bind Vm.RestoreWindowsCommand}" HorizontalAlignment="Left"/><Button Content="刷新可收起的窗口" Click="RefreshWindows_Click" HorizontalAlignment="Left"/><StackPanel x:Name="WindowsList" Spacing="8"/></StackPanel></Border></StackPanel></ScrollViewer>
   <ScrollViewer x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed"><StackPanel Spacing="16" MaxWidth="680" HorizontalAlignment="Left">
    <Border Style="{StaticResource Card}"><StackPanel Spacing="18"><TextBlock Text="启动与驻留" FontSize="18" FontWeight="SemiBold"/><ToggleSwitch Header="登录 Windows 后自动启动" IsOn="{x:Bind Vm.Startup, Mode=TwoWay}"/><ToggleSwitch Header="显示助手自己的托盘图标" IsOn="{x:Bind Vm.OwnVisible, Mode=TwoWay}"/><TextBlock Text="关闭图标后，可再次启动助手或按 Ctrl + Alt + T 打开界面。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBox Header="助手图标" Text="{x:Bind Vm.OwnAsset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/><Button Content="选择助手图标…" Command="{x:Bind Vm.ChooseOwnIconCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel Spacing="18"><TextBlock Text="外观与恢复" FontSize="18" FontWeight="SemiBold"/><ComboBox Header="主题" SelectedIndex="{x:Bind Vm.ThemeIndex, Mode=TwoWay}"><x:String>跟随 Windows</x:String><x:String>浅色</x:String><x:String>深色</x:String></ComboBox><ToggleSwitch Header="安全模式：暂停托盘定制" IsOn="{x:Bind Vm.SafeMode, Mode=TwoWay}"/><Button Content="保存偏好" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.SavePreferencesCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel Spacing="16"><TextBlock Text="配置备份" FontSize="18" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="导出配置…" Click="Export_Click"/><Button Content="导入配置…" Click="Import_Click"/></StackPanel><TextBlock Text="图标资源与规则一起备份。" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Border>
   </StackPanel></ScrollViewer>
   <ScrollViewer x:Name="DiagnosticsView" Grid.Row="1" Visibility="Collapsed"><StackPanel Spacing="16"><Border Style="{StaticResource Card}"><StackPanel Spacing="18"><TextBlock Text="{x:Bind Vm.Diagnostics, Mode=OneWay}" FontFamily="Cascadia Code" TextWrapping="Wrap"/><TextBlock Text="当前适配范围：本机已验证的 Windows 11 任务栏版本。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Button Content="停止后台并恢复托盘" Command="{x:Bind Vm.StopAgentCommand}" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel></ScrollViewer>
   <InfoBar Grid.Row="2" IsOpen="True" IsClosable="False" Severity="Informational" Message="{x:Bind Vm.Status, Mode=OneWay}"/>
  </Grid>
 </NavigationView>
</Page>
