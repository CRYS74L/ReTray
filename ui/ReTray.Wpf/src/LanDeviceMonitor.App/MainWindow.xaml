                                </Grid>
                            </StackPanel>
                        </controls:RoundedCardBorder>
                        <TextBlock x:Name="AppSettingsAutoSaveText" Visibility="Collapsed" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Right" Margin="0,12,0,0"/>
