<Page x:Class="TrayAssistant_App.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:TrayAssistant_App.Models" xmlns:controls="using:TrayAssistant_App.Controls" Loaded="Page_Loaded" Background="Transparent" FontFamily="{StaticResource AppUiFontFamily}">
 <Page.Resources>
  <x:Double x:Key="ToggleSwitchPreContentMargin">7</x:Double>
  <x:Double x:Key="ToggleSwitchPostContentMargin">7</x:Double>
  <SolidColorBrush x:Key="SkeletonBrush" Color="#FF808080" Opacity="0.16"/>
  <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
  <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent"/>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="14"/></Style>
 </Page.Resources>
 <Grid>
  <NavigationView x:Name="Nav" PaneDisplayMode="Top" OpenPaneLength="0" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" Loaded="Nav_Loaded" SelectionChanged="Nav_SelectionChanged">
   <NavigationView.MenuItems><NavigationViewItem Content="托盘图标" Tag="icons" AutomationProperties.AutomationId="NavIcons" IsSelected="True"/><NavigationViewItem Content="设置" Tag="settings" AutomationProperties.AutomationId="NavSettings"/><NavigationViewItem Content="状态" Tag="diagnostics" AutomationProperties.AutomationId="NavDiagnostics"/></NavigationView.MenuItems>
   <Grid Margin="14,6,2,10" RowSpacing="10">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="LoadingList" IsHitTestVisible="False" Style="{StaticResource EdgeScrollViewerStyle}" AutomationProperties.AutomationId="TrayLoadingPlaceholders">
     <ItemsControl x:Name="LoadingRows"><ItemsControl.ItemTemplate><DataTemplate>
      <Grid Height="34" ColumnSpacing="8" Padding="4,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
       <Border Width="20" Height="20" CornerRadius="5" Background="{StaticResource SkeletonBrush}"/>
       <Border Grid.Column="1" Width="112" Height="10" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="4" Background="{StaticResource SkeletonBrush}"/>
       <Border Grid.Column="2" Width="38" Height="18" VerticalAlignment="Center" CornerRadius="9" Background="{StaticResource SkeletonBrush}"/>
       <Border Grid.Column="3" Width="20" Height="8" VerticalAlignment="Center" CornerRadius="4" Background="{StaticResource SkeletonBrush}"/>
      </Grid>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </ScrollViewer>
    <ListView x:Name="IconList" Padding="0" ItemsSource="{x:Bind Vm.Icons}" SelectionMode="None" CanDragItems="True" CanReorderItems="True" AllowDrop="True" DragItemsStarting="IconList_DragItemsStarting" DragItemsCompleted="IconList_DragItemsCompleted" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="TrayIconList">
     <ListView.Template><ControlTemplate TargetType="ListView">
      <Border Background="{TemplateBinding Background}">
       <ScrollViewer x:Name="ScrollViewer" Margin="0" Style="{StaticResource EdgeScrollViewerStyle}" TabNavigation="{TemplateBinding TabNavigation}" BringIntoViewOnFocusChange="True" AutomationProperties.AccessibilityView="Raw">
        <ItemsPresenter Padding="{TemplateBinding Padding}"/>
       </ScrollViewer>
      </Border>
     </ControlTemplate></ListView.Template>
     <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="4,0,4,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/></ControlTemplate></Setter.Value></Setter></Style></ListView.ItemContainerStyle>
     <ListView.ItemTemplate><DataTemplate x:DataType="models:IconRow">
      <Grid Height="34" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
       <controls:TrayIconButton VerticalAlignment="Center" ImageSource="{x:Bind Image, Mode=OneWay}" Tag="{x:Bind}" NativeAction="Icon_NativeAction" AutomationProperties.Name="{x:Bind Name}" AutomationProperties.AutomationId="TrayNativeAction"/>
       <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13" ToolTipService.ToolTip="{x:Bind Tip, Mode=OneWay}"/>
       <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" IsOn="{x:Bind Visible, Mode=OneWay}" IsEnabled="{x:Bind CanToggle, Mode=OneWay}" Tag="{x:Bind Mode=OneWay}" Toggled="Visibility_Toggled" AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" AutomationProperties.AutomationId="TrayVisibility"/>
       <Button Grid.Column="3" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="4" VerticalAlignment="Center" Tag="{x:Bind}" Click="IconSettings_Click" AutomationProperties.Name="图标设置" AutomationProperties.AutomationId="IconSettings"><FontIcon Glyph="&#xE712;" FontSize="12"/></Button>
       <Border Grid.Column="1" Grid.ColumnSpan="3" Height="0.5" VerticalAlignment="Bottom" Background="{ThemeResource TrayRowSeparatorBrush}" IsHitTestVisible="False"/>
      </Grid>
     </DataTemplate></ListView.ItemTemplate>
    </ListView>
    <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" Style="{StaticResource EdgeScrollViewerStyle}" AutomationProperties.AutomationId="SettingsScroll">
     <StackPanel Spacing="12">
      <Border Style="{StaticResource Card}"><StackPanel Spacing="14">
       <Grid MinHeight="32"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="开机启动" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" IsOn="{x:Bind Vm.Startup, Mode=TwoWay}" AutomationProperties.Name="开机启动" AutomationProperties.AutomationId="StartupToggle"/></Grid>
       <controls:BelowComboBox AutomationProperties.AutomationId="ThemeChoice" Header="主题" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind Vm.ThemeIndex, Mode=TwoWay}"><x:String>跟随 Windows</x:String><x:String>浅色</x:String><x:String>深色</x:String></controls:BelowComboBox>
       <controls:BelowComboBox AutomationProperties.AutomationId="LanguageChoice" Header="语言" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind Vm.LanguageIndex, Mode=TwoWay}"><x:String>简体中文</x:String><x:String>English</x:String></controls:BelowComboBox>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel Spacing="14">
       <TextBlock Text="助手图标" FontWeight="SemiBold"/>
       <Grid MinHeight="32"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="显示助手托盘图标" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" IsOn="{x:Bind Vm.OwnVisible, Mode=TwoWay}" AutomationProperties.Name="显示助手托盘图标" AutomationProperties.AutomationId="OwnIconToggle"/></Grid>
       <TextBox Header="图标提示" MaxLength="127" Text="{x:Bind Vm.OwnTip, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="OwnIconTip"/>
       <Button Content="选择助手图标…" Command="{x:Bind Vm.ChooseOwnIconCommand}" HorizontalAlignment="Left"/>
       <TextBlock Text="{x:Bind Vm.OwnAsset, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontSize="11"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="系统图标" FontWeight="SemiBold"/><StackPanel x:Name="SystemList" Spacing="4"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel Spacing="14"><TextBlock Text="高级设置" FontWeight="SemiBold"/>
       <Grid MinHeight="32"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="助手窗口置顶" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" IsOn="{x:Bind Vm.UiTopmost, Mode=TwoWay}" AutomationProperties.Name="助手窗口置顶" AutomationProperties.AutomationId="TopmostToggle"/></Grid>
       <Grid MinHeight="32"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="隐藏开始按钮" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" IsOn="{x:Bind Vm.HideStart, Mode=TwoWay}" AutomationProperties.Name="隐藏开始按钮" AutomationProperties.AutomationId="HideStartToggle"/></Grid>
       <Slider Header="任务栏不透明度" Minimum="40" Maximum="255" Value="{x:Bind Vm.TaskbarOpacity, Mode=TwoWay}" AutomationProperties.AutomationId="TaskbarOpacity"/>
       <Grid MinHeight="32"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="自动按名称排序" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" IsOn="{x:Bind Vm.AutoSort, Mode=TwoWay}" AutomationProperties.Name="自动按名称排序" AutomationProperties.AutomationId="AutoSortToggle"/></Grid>
       <TextBox x:Name="Hotkey_open" Header="打开助手快捷键" Tag="open" IsReadOnly="True" KeyDown="HotkeyBox_KeyDown"/>
       <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="导出配置…" Click="Export_Click"/><Button Content="导入配置…" Click="Import_Click"/></StackPanel>
      </StackPanel></Border>
     </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="DiagnosticsView" Visibility="Collapsed" Style="{StaticResource EdgeScrollViewerStyle}"><StackPanel Spacing="14"><TextBlock Text="{x:Bind Vm.Diagnostics, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"/><Button Content="退出软件" AutomationProperties.AutomationId="ExitAssistant" Click="Exit_Click"/><TextBlock Text="v0.1.12 · 开发中" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></ScrollViewer>
    <InfoBar x:Name="ErrorNotice" Grid.Row="1" Margin="0,0,12,0" IsOpen="False" IsClosable="False" Severity="Error" Message="{x:Bind Vm.Error, Mode=OneWay}" AutomationProperties.AutomationId="OperationError"><InfoBar.ActionButton><Button Content="重试" Command="{x:Bind Vm.ReconnectCommand}"/></InfoBar.ActionButton></InfoBar>
   </Grid>
  </NavigationView>
  <ContentControl x:Name="IconEditor" Visibility="Collapsed">
   <ScrollViewer Style="{StaticResource EdgeScrollViewerStyle}" AutomationProperties.AutomationId="IconEditorScroll"><StackPanel Spacing="14">
    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Spacing="8"><Image Source="{x:Bind Vm.Selected.Original, Mode=OneWay}" Width="36" Height="36" Stretch="Uniform"/><TextBlock Text="原图标" HorizontalAlignment="Center" FontSize="12"/></StackPanel><StackPanel Grid.Column="1" Spacing="8"><Image Source="{x:Bind Vm.AssetPreview, Mode=OneWay}" Width="36" Height="36" Stretch="Uniform"/><TextBlock Text="替代图标" HorizontalAlignment="Center" FontSize="12"/></StackPanel></Grid>
    <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="选择图标…" Command="{x:Bind Vm.ChooseIconCommand}"/><Button Content="使用原图标" Command="{x:Bind Vm.UseOriginalAssetCommand}"/></StackPanel>
    <TextBlock Text="{x:Bind Vm.AssetSummary, Mode=OneWay}" FontSize="11"/>
    <TextBox Header="图标提示" MaxLength="127" Text="{x:Bind Vm.Tip, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="IconTip"/>
    <Expander Header="更多设置" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="IconAdvancedSettings"><StackPanel Spacing="14">
     <NumberBox Header="EXE / DLL 图标序号" Minimum="0" Maximum="10000" Value="{x:Bind Vm.AssetIndex, Mode=TwoWay}" SpinButtonPlacementMode="Inline" AutomationProperties.AutomationId="IconAssetIndex"/>
     <Grid MinHeight="32"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="交换左右键" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" IsOn="{x:Bind Vm.SwapButtons, Mode=TwoWay}" AutomationProperties.Name="交换左右键" AutomationProperties.AutomationId="SwapButtonsToggle"/></Grid>
     <NumberBox Header="不活动后隐藏（秒，0 关闭）" Minimum="0" Maximum="86400" Value="{x:Bind Vm.InactiveSeconds, Mode=TwoWay}" AutomationProperties.AutomationId="IconInactiveSeconds"/>
     <TextBox Header="图标快捷键" Text="{x:Bind Vm.HotkeyText, Mode=OneWay}" IsReadOnly="True" Tag="icon" KeyDown="HotkeyBox_KeyDown"/>
     <controls:BelowComboBox AutomationProperties.AutomationId="IconHotkeyActionChoice" Header="快捷键动作" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind Vm.HotkeyAction, Mode=TwoWay}"><x:String>左键</x:String><x:String>右键</x:String><x:String>左键双击</x:String><x:String>右键双击</x:String></controls:BelowComboBox>
    </StackPanel></Expander>
    <TextBlock Text="{x:Bind Vm.Error, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
   </StackPanel></ScrollViewer>
  </ContentControl>
 </Grid>
</Page>
