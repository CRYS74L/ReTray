                                    <TextBox controls:InputPlaceholder.Text="开启后显示访问地址" x:Name="LanAddressBox" IsReadOnly="True" AutomationProperties.Name="局域网访问地址" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
