<Page x:Class="TrayAssistant_App.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:TrayAssistant_App.Models" xmlns:controls="using:TrayAssistant_App.Controls" Loaded="Page_Loaded" Background="Transparent">
 <Page.Resources><SolidColorBrush x:Key="SkeletonBrush" Color="#FF808080" Opacity="0.16"/><SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/><SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent"/><SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/><SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="Transparent"/><Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="14"/></Style></Page.Resources>
 <Grid>
 <NavigationView x:Name="Nav" PaneDisplayMode="Top" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="Nav_SelectionChanged">
  <NavigationView.MenuItems><NavigationViewItem Content="托盘图标" Tag="icons" AutomationProperties.AutomationId="NavIcons" IsSelected="True"/><NavigationViewItem Content="设置" Tag="settings" AutomationProperties.AutomationId="NavSettings"/><NavigationViewItem Content="状态" Tag="diagnostics" AutomationProperties.AutomationId="NavDiagnostics"/></NavigationView.MenuItems>
  <Grid Margin="14,8,14,14" RowSpacing="12">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer x:Name="LoadingList" Grid.Row="0" IsHitTestVisible="False" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="TrayLoadingPlaceholders">
    <ItemsControl x:Name="LoadingRows"><ItemsControl.ItemTemplate><DataTemplate>
     <Grid Height="57" ColumnSpacing="8" Padding="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
      <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource SkeletonBrush}"/>
      <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center"><Border Width="112" Height="11" HorizontalAlignment="Left" CornerRadius="4" Background="{StaticResource SkeletonBrush}"/><Border Width="68" Height="8" HorizontalAlignment="Left" CornerRadius="4" Background="{StaticResource SkeletonBrush}"/></StackPanel>
      <Border Grid.Column="2" Width="74" Height="20" HorizontalAlignment="Left" CornerRadius="10" Background="{StaticResource SkeletonBrush}"/><Border Grid.Column="3" Width="24" Height="12" CornerRadius="4" Background="{StaticResource SkeletonBrush}"/>
     </Grid>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </ScrollViewer>
   <ListView x:Name="IconList" Grid.Row="0" ItemsSource="{x:Bind Vm.Icons}" SelectionMode="None" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="TrayIconList">
    <ListView.ItemTemplate><DataTemplate x:DataType="models:IconRow">
     <Grid Padding="0,8" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
      <controls:TrayIconButton ImageSource="{x:Bind Image, Mode=OneWay}" Tag="{x:Bind}" NativeAction="Icon_NativeAction" AutomationProperties.Name="{x:Bind Name}" AutomationProperties.AutomationId="TrayNativeAction"/>
      <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center"><TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/><TextBlock Text="{x:Bind State, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{x:Bind Tip, Mode=OneWay}"/></StackPanel>
      <ToggleSwitch Grid.Column="2" MinWidth="0" VerticalAlignment="Center" IsOn="{x:Bind Visible, Mode=TwoWay}" IsEnabled="{x:Bind CanToggle, Mode=OneWay}" Tag="{x:Bind}" OnContent="显示" OffContent="隐藏" Toggled="Visibility_Toggled" AutomationProperties.Name="{x:Bind Name}" AutomationProperties.AutomationId="TrayVisibility"/>
      <Button Grid.Column="3" Width="30" Padding="4" VerticalAlignment="Center" Tag="{x:Bind}" Click="IconSettings_Click" AutomationProperties.Name="图标设置"><FontIcon Glyph="&#xE712;" FontSize="14"/></Button>
     </Grid>
    </DataTemplate></ListView.ItemTemplate>
   </ListView>
   <ScrollViewer x:Name="SettingsView" Grid.Row="0" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="12">
    <Border Style="{StaticResource Card}"><StackPanel Spacing="14"><ToggleSwitch Header="开机启动" IsOn="{x:Bind Vm.Startup, Mode=TwoWay}"/><ComboBox DropDownOpened="PopupMica_Open" Header="主题" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind Vm.ThemeIndex, Mode=TwoWay}"><x:String>跟随 Windows</x:String><x:String>浅色</x:String><x:String>深色</x:String></ComboBox><ComboBox DropDownOpened="PopupMica_Open" Header="语言" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind Vm.LanguageIndex, Mode=TwoWay}"><x:String>简体中文</x:String><x:String>English</x:String></ComboBox></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel Spacing="14"><TextBlock Text="助手图标" FontWeight="SemiBold"/><ToggleSwitch Header="显示助手托盘图标" IsOn="{x:Bind Vm.OwnVisible, Mode=TwoWay}"/><TextBox Header="图标提示" MaxLength="127" Text="{x:Bind Vm.OwnTip, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><Button Content="选择助手图标…" Command="{x:Bind Vm.ChooseOwnIconCommand}" HorizontalAlignment="Left"/><TextBlock Text="{x:Bind Vm.OwnAsset, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontSize="11"/><Button Content="保存设置" Command="{x:Bind Vm.SavePreferencesCommand}" Style="{StaticResource AccentButtonStyle}"/></StackPanel></Border>
    <Expander Header="系统图标" HorizontalAlignment="Stretch"><StackPanel Spacing="12"><Button Content="读取系统图标" Click="ReadSystem_Click"/><StackPanel x:Name="SystemList" Spacing="12"/></StackPanel></Expander>
    <Expander Header="高级设置" HorizontalAlignment="Stretch"><StackPanel Spacing="14"><ToggleSwitch Header="助手窗口置顶" IsOn="{x:Bind Vm.UiTopmost, Mode=TwoWay}"/><ToggleSwitch Header="隐藏开始按钮" IsOn="{x:Bind Vm.HideStart, Mode=TwoWay}"/><Slider Header="任务栏不透明度" Minimum="40" Maximum="255" Value="{x:Bind Vm.TaskbarOpacity, Mode=TwoWay}"/><Button Content="应用" Command="{x:Bind Vm.SaveAdvancedCommand}"/><ToggleSwitch Header="自动按名称排序" IsOn="{x:Bind Vm.AutoSort, Mode=TwoWay}"/><ComboBox DropDownOpened="PopupMica_Open" Header="新图标位置" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind Vm.NewLocationIndex, Mode=TwoWay}"><x:String>跟随 Windows</x:String><x:String>任务栏</x:String><x:String>折叠区</x:String></ComboBox><Button Content="应用排序" Command="{x:Bind Vm.SaveMenuCommand}"/><TextBox x:Name="Hotkey_open" Header="打开助手快捷键" Tag="open" IsReadOnly="True" KeyDown="HotkeyBox_KeyDown"/><TextBox x:Name="Hotkey_restoreIcons" Header="恢复托盘快捷键" Tag="restoreIcons" IsReadOnly="True" KeyDown="HotkeyBox_KeyDown"/><Button Content="保存快捷键" Command="{x:Bind Vm.SaveMenuCommand}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="导出配置…" Click="Export_Click"/><Button Content="导入配置…" Click="Import_Click"/></StackPanel></StackPanel></Expander>
   </StackPanel></ScrollViewer>
   <ScrollViewer x:Name="DiagnosticsView" Grid.Row="0" Visibility="Collapsed"><StackPanel Spacing="14"><TextBlock Text="{x:Bind Vm.Diagnostics, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"/><Button Content="恢复所有托盘图标" Click="RestoreAll_Click"/><Button Content="停止后台" AutomationProperties.AutomationId="StopAgent" Command="{x:Bind Vm.StopAgentCommand}"/><TextBlock Text="v0.1.6 · 开发中" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></ScrollViewer>
   <InfoBar x:Name="ErrorNotice" Grid.Row="1" IsOpen="False" IsClosable="False" Severity="Error" Message="{x:Bind Vm.Error, Mode=OneWay}" AutomationProperties.AutomationId="OperationError"><InfoBar.ActionButton><Button Content="重试" Command="{x:Bind Vm.ReconnectCommand}"/></InfoBar.ActionButton></InfoBar>
  </Grid>
 </NavigationView>
 <ContentDialog x:Name="IconEditor" Title="图标设置" PrimaryButtonText="应用" CloseButtonText="关闭" PrimaryButtonClick="Editor_Apply" Background="Transparent">
  <ScrollViewer MaxHeight="480" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="14">
   <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Spacing="8"><Image Source="{x:Bind Vm.Selected.Original, Mode=OneWay}" Width="48" Height="48"/><TextBlock Text="原图标" HorizontalAlignment="Center" FontSize="12"/></StackPanel><StackPanel Grid.Column="1" Spacing="8"><Image Source="{x:Bind Vm.AssetPreview, Mode=OneWay}" Width="48" Height="48"/><TextBlock Text="替代图标" HorizontalAlignment="Center" FontSize="12"/></StackPanel></Grid>
   <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="选择图标…" Command="{x:Bind Vm.ChooseIconCommand}"/><Button Content="使用原图标" Command="{x:Bind Vm.UseOriginalAssetCommand}"/></StackPanel><TextBlock Text="{x:Bind Vm.AssetSummary, Mode=OneWay}" FontSize="11"/><TextBox Header="图标提示" MaxLength="127" Text="{x:Bind Vm.Tip, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
   <ComboBox DropDownOpened="PopupMica_Open" Header="位置" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind Vm.LocationIndex, Mode=TwoWay}"><x:String>保持原位置</x:String><x:String>任务栏</x:String><x:String>折叠区</x:String></ComboBox>
   <Expander Header="更多设置" HorizontalAlignment="Stretch"><StackPanel Spacing="14"><NumberBox Header="EXE / DLL 图标序号" Minimum="0" Maximum="10000" Value="{x:Bind Vm.AssetIndex, Mode=TwoWay}" SpinButtonPlacementMode="Inline"/><ToggleSwitch Header="交换左右键" IsOn="{x:Bind Vm.SwapButtons, Mode=TwoWay}"/><NumberBox Header="不活动后隐藏（秒，0 关闭）" Minimum="0" Maximum="86400" Value="{x:Bind Vm.InactiveSeconds, Mode=TwoWay}"/><TextBox Header="图标快捷键" Text="{x:Bind Vm.HotkeyText, Mode=OneWay}" IsReadOnly="True" Tag="icon" KeyDown="HotkeyBox_KeyDown"/><ComboBox DropDownOpened="PopupMica_Open" Header="快捷键动作" SelectedIndex="{x:Bind Vm.HotkeyAction, Mode=TwoWay}"><x:String>左键</x:String><x:String>右键</x:String><x:String>左键双击</x:String><x:String>右键双击</x:String></ComboBox></StackPanel></Expander>
   <Button Content="恢复默认" Command="{x:Bind Vm.ResetRuleCommand}" HorizontalAlignment="Left"/><TextBlock Text="{x:Bind Vm.Status, Mode=OneWay}" TextWrapping="Wrap" FontSize="12"/>
  </StackPanel></ScrollViewer>
 </ContentDialog>
 </Grid>
</Page>





