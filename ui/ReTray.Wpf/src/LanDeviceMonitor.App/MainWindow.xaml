                                <Grid SizeChanged="DoNotDisturbTimeRow_SizeChanged" x:Name="DoNotDisturbTimeRow" Visibility="{Binding IsChecked, ElementName=DoNotDisturbCheck, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,14" IsEnabled="{Binding IsChecked, ElementName=DoNotDisturbCheck}">
