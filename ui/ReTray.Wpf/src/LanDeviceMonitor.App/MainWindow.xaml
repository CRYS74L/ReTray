<Window x:Class="LanDeviceMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LanDeviceMonitor.Controls"
        mc:Ignorable="d"
        Title="ReTray"
        FontFamily="{StaticResource AppTextFont}"
        Width="440" Height="720"
        MinWidth="300" MinHeight="260"
        Icon="/ReTray;component/Assets/WindowIcon.ico"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="12"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="IdentityTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource CrispTextStyle}"><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
        <Style x:Key="DetailSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource CrispTextStyle}"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource SectionTitleBrush}"/></Style>
        <Geometry x:Key="TrafficRateArrowGeometry">M12 19.5V4.5M4.7 11.8L12 4.5L19.3 11.8</Geometry>
        <GeometryGroup x:Key="TrafficTotalDownloadIconGeometry">
            <EllipseGeometry Center="14,14"
                             RadiusX="10.2"
                             RadiusY="10.2"/>
            <PathGeometry Figures="M14 8.6V19.4M8.8 14.2L14 19.4L19.2 14.2"/>
        </GeometryGroup>
        <GeometryGroup x:Key="TrafficTotalUploadIconGeometry">
            <EllipseGeometry Center="14,14"
                             RadiusX="10.2"
                             RadiusY="10.2"/>
            <PathGeometry Figures="M14 19.4V8.6M8.8 13.8L14 8.6L19.2 13.8"/>
        </GeometryGroup>
        <Style x:Key="MetricCardToolTipStyle" TargetType="ToolTip">
            <Setter Property="controls:ToolTipContentGuard.Enabled" Value="True"/>
            <Setter Property="controls:ToolTipContentGuard.CloseOnScroll" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceStrongBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TimelineItemBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2,4"/>
            <Setter Property="FontFamily" Value="{StaticResource AppTextFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <controls:HistoryDateTextBlock DateText="{Binding}"
                                   RangeSeparatorSpaceRatio="0.5"
                                   Style="{StaticResource {x:Type TextBlock}}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="12"
                                   FontWeight="Normal"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Center"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource CapsuleRadius}}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CaptionHoverBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"/>
                            <Border x:Name="CaptionHoverSurface"
                                    Background="{TemplateBinding BorderBrush}"
                                    Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionHoverSurface"
                                        Property="Opacity"
                                        Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionHoverSurface"
                                        Property="Opacity"
                                        Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionBackButtonStyle" TargetType="controls:CaptionBackButton">
            <Setter Property="Width" Value="84"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="13.2,0,8,0"/>
            <Setter Property="FontFamily" Value="{StaticResource AppTextFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="IdleColor" Value="{DynamicResource CaptionBackIdleColor}"/>
            <Setter Property="HoverColor" Value="{DynamicResource CaptionBackHoverColor}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:CaptionBackButton">
                        <Grid x:Name="CaptionBackMotionRoot" Background="Transparent">
                            <StackPanel x:Name="CaptionBackContent" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                                <Path x:Name="CaptionBackArrow" Data="M710.153924 8.980397L266.007127 460.692524a81.118646 81.118646 0 0 0 0.861532 114.476097l446.192936 441.050666a26.922883 26.922883 0 0 0 37.853573-38.284339L304.722232 536.884282a27.27288 27.27288 0 0 1-0.323074-38.445877L748.545955 46.726278A26.922883 26.922883 0 1 0 710.180847 9.00732z" Width="7" Height="10.8" Stretch="Uniform"
                                      VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" Stroke="{TemplateBinding Foreground}" StrokeThickness="0.25" StrokeLineJoin="Round"/>
                                <TextBlock x:Name="CaptionBackLabel" Text="返回" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"/>
                            </StackPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"/>
                            <Border x:Name="CaptionHoverSurface"
                                    Background="{TemplateBinding BorderBrush}"
                                    Opacity="0"
                                    IsHitTestVisible="False"/>
                            <Grid HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <TextBlock x:Name="CloseGlyph"
                                           Text="&#xE8BB;"
                                           FontFamily="{StaticResource AppIconFont}"
                                           FontSize="10"
                                           Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="CloseGlyphLight"
                                           Text="&#xE8BB;"
                                           FontFamily="{StaticResource AppIconFont}"
                                           FontSize="10"
                                           Foreground="White"
                                           Opacity="0"
                                           IsHitTestVisible="False"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CaptionHoverSurface"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CloseGlyphLight"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CaptionHoverSurface"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CloseGlyphLight"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionHoverSurface"
                                        Property="Opacity"
                                        Value="0.82"/>
                                <Setter TargetName="CloseGlyphLight"
                                        Property="Opacity"
                                        Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FF525C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Proportions and colors sampled from the user-provided iPadOS close-up. -->

        <Style x:Key="DeviceListScrollViewerStyle" TargetType="ScrollViewer" BasedOn="{StaticResource WindowsSettingsScrollViewerStyle}">
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer"><Grid Background="{TemplateBinding Background}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions>
                <Grid x:Name="DeviceViewportMask" Background="Transparent" ClipToBounds="True"><ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/></Grid>
                <ScrollBar x:Name="PART_VerticalScrollBar" MinWidth="0" Width="10" Grid.Column="1" Orientation="Vertical" Margin="0" HorizontalAlignment="Center" Style="{StaticResource WindowsSettingsScrollBarStyle}" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
            </Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="DeviceListBoxStyle" TargetType="ListBox">

            <Setter Property="Padding" Value="0"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer controls:DeviceListViewport.Enabled="True" x:Name="PART_ScrollViewer"
                                      Style="{StaticResource DeviceListScrollViewerStyle}"
                                      Focusable="False"
                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}">
                            <ItemsPresenter x:Name="DeviceItemsMotion"/>
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                    <Setter Property="controls:CapsulePressMotion.Enabled" Value="True"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,5"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid x:Name="ItemMotionRoot" MinHeight="52">
                                        <Border x:Name="ItemBorder"
                                                Background="{DynamicResource DeviceListItemBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource CapsuleRadius}}"/>
                                        <Border x:Name="SelectedBorder"
                                                Background="{DynamicResource DeviceListItemSelectedBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource CapsuleRadius}}"
                                                Opacity="0"
                                                IsHitTestVisible="False"/>
                                        <Border x:Name="HoverBorder"
                                                Background="{DynamicResource FooterHoverBrush}"
                                                BorderBrush="{DynamicResource FooterHoverBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource CapsuleRadius}}"
                                                Opacity="0"
                                                IsHitTestVisible="False"/>
                                        <Border x:Name="PressedBorder" Background="{DynamicResource DevicePressedBrush}" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource CapsuleRadius}}" Opacity="0" IsHitTestVisible="False"/>
                                        <ContentPresenter Margin="8,8,18,8" UseLayoutRounding="False"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="SelectedBorder"
                                                    Property="Opacity"
                                                    Value="1"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions><BeginStoryboard HandoffBehavior="SnapshotAndReplace"><Storyboard><DoubleAnimation Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
                                            <Trigger.ExitActions><BeginStoryboard HandoffBehavior="SnapshotAndReplace"><Storyboard><DoubleAnimation Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(controls:CapsulePressMotion.IsPressed)}" Value="True">
                                            <Setter TargetName="HoverBorder" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="PressedBorder" Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="DeviceRowIconBackground" Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Left"
                                    Background="{DynamicResource DeviceIconBrush}">
                                <controls:DeviceTypeIcon x:Name="DeviceRowIcon" DeviceType="{Binding TypeName}"
                                                         Glyph="{Binding IconGlyph}"
                                                         IconBrush="{DynamicResource AccentBrush}"
                                                         Width="20" Height="20"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                <controls:DeviceNameTextBlock Style="{StaticResource {x:Type TextBlock}}" NameText="{Binding DisplayName}" FontWeight="Normal" FontSize="14"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>

                            </StackPanel>
                            <TextBlock x:Name="DeviceListRate" Grid.Column="2" Text="{Binding OnlineElapsedText}" ToolTip="{Binding OnlineSinceText}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBlock x:Name="OfflineRatePlaceholder" Grid.Column="2" Text="{Binding OfflineElapsedText}" ToolTip="{Binding OfflineSinceText}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Collapsed"/>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsOnline}" Value="True">

                                </DataTrigger>
                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                <Setter TargetName="DeviceRowIcon" Property="IconBrush" Value="{DynamicResource MutedTextBrush}"/><Setter TargetName="DeviceRowIconBackground" Property="Background" Value="{DynamicResource OfflineDeviceIconBrush}"/><Setter TargetName="DeviceListRate" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="OfflineRatePlaceholder" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Geometry x:Key="SidebarPanelGeometry">F0 M5.5,2.9 H14.5 C16.52,2.9 18.16,4.52 18.16,6.54 V13.46 C18.16,15.48 16.52,17.12 14.5,17.12 H5.5 C3.48,17.12 1.84,15.48 1.84,13.46 V6.54 C1.84,4.52 3.48,2.9 5.5,2.9 Z M5.5,3.98 C4.08,3.98 2.92,5.13 2.92,6.54 V13.46 C2.92,14.88 4.08,16.04 5.5,16.04 H6.96 V3.98 Z M8.04,3.98 V16.04 H14.5 C15.92,16.04 17.08,14.88 17.08,13.46 V6.54 C17.08,5.13 15.92,3.98 14.5,3.98 Z</Geometry>
        <Style x:Key="SidebarNavButtonStyle" TargetType="Button" BasedOn="{StaticResource FluentButtonBaseStyle}">
            <Setter Property="Height" Value="40"/><Setter Property="MinHeight" Value="36"/><Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="10,5"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid>
                <Border Background="{TemplateBinding Background}" CornerRadius="10"/>
                <Border x:Name="NavHover" Background="{DynamicResource QuietControlBrush}" CornerRadius="10" Opacity="0" IsHitTestVisible="False"/>
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Grid><ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="NavHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="NavHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="NavHover" Property="Background" Value="{DynamicResource AccentLightBrush}"/></Trigger>
            </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SidebarKeyboardFocusStyle" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control"><Border Margin="2" BorderBrush="{DynamicResource MutedTextBrush}" BorderThickness="1" CornerRadius="18"/></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SelectedDeviceIconStyle" TargetType="controls:DeviceTypeIcon"><Setter Property="IconBrush" Value="{DynamicResource AccentBrush}"/><Style.Triggers><DataTrigger Binding="{Binding SelectedDevice.IsOnline}" Value="False"><Setter Property="IconBrush" Value="{DynamicResource MutedTextBrush}"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="SidebarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource FluentButtonBaseStyle}">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="FocusVisualStyle" Value="{StaticResource SidebarKeyboardFocusStyle}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid Background="Transparent">
                <Border x:Name="IconHover" CornerRadius="18" Background="{DynamicResource SidebarHoverBrush}" Opacity="0" IsHitTestVisible="False"/>
                <Border x:Name="IconPressed" CornerRadius="18" Background="{DynamicResource SidebarPressedBrush}" Opacity="0" IsHitTestVisible="False"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid><ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="IconHover" Property="Opacity" Value="1"/></Trigger>

                <Trigger Property="IsPressed" Value="True"><Setter TargetName="IconPressed" Property="Opacity" Value="1"/></Trigger>
            </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FooterCircleButtonStyle" TargetType="Button" BasedOn="{StaticResource FluentButtonBaseStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="MinWidth" Value="36"/><Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource FooterButtonBorderBrush}"/><Setter Property="BorderThickness" Value="0.75"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid Background="Transparent">
                <controls:CircleButtonBorder x:Name="CircleSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18"/>
                <Border x:Name="CircleHover" Margin="0.75" Background="{DynamicResource FooterHoverBrush}" CornerRadius="17.25" Opacity="0" IsHitTestVisible="False"/>
                <Border x:Name="CirclePressed" Margin="0.75" Background="{DynamicResource FooterPressedBrush}" CornerRadius="17.25" Opacity="0" IsHitTestVisible="False"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid><ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource FooterIconHoverBrush}"/><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="CircleHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="CircleHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter TargetName="CircleHover" Property="Visibility" Value="Collapsed"/><Setter TargetName="CirclePressed" Property="Opacity" Value="1"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CircleHover" Property="Opacity" Value="1"/></Trigger>
            </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="WindowRoot"
          Background="{DynamicResource MicaPanelBrush}"
          SnapsToDevicePixels="True"
          UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent">
            <Border Panel.ZIndex="2" Background="Transparent" Height="6" VerticalAlignment="Top" shell:WindowChrome.ResizeGripDirection="Top"/><Border Panel.ZIndex="3" Background="Transparent" Width="6" Height="6" VerticalAlignment="Top" HorizontalAlignment="Right" shell:WindowChrome.ResizeGripDirection="TopRight"/><Border Panel.ZIndex="3" Background="Transparent" Width="6" Height="6" VerticalAlignment="Top" HorizontalAlignment="Left" shell:WindowChrome.ResizeGripDirection="TopLeft"/>

            <controls:CaptionBackButton x:Name="CaptionBackButton"
                                        Style="{StaticResource CaptionBackButtonStyle}"
                                        HorizontalAlignment="Left"
                                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                        Click="CompactBackButton_Click"
                                        ToolTipService.IsEnabled="False"
                                        AutomationProperties.Name="返回设备列表"/>

