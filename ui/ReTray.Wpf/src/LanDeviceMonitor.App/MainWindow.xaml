                                <TextBlock x:Name="WebAccessStatus" Text="" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,10"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                <Grid x:Name="LanAccessDetails" Visibility="Collapsed" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
