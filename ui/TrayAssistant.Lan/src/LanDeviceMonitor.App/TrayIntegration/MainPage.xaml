<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="clr-namespace:LanDeviceMonitor.Controls" xmlns:tray="clr-namespace:TrayAssistant_App.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TrayAssistant_App.MainPage" UseLayoutRounding="False" SnapsToDevicePixels="False">
  <UserControl.Resources>
    <Style TargetType="ListBoxItem" x:Key="TrayListItemStyle">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,5" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid x:Name="ItemMotionRoot" MinHeight="{TemplateBinding MinHeight}">
              <Border Background="Transparent" />
              <ContentPresenter Margin="{TemplateBinding Padding}" UseLayoutRounding="False" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SettingToggle" TargetType="controls:SwitchControl" BasedOn="{StaticResource {x:Type controls:SwitchControl}}">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style x:Key="TrayRowToggle" TargetType="controls:SwitchControl" BasedOn="{StaticResource SettingToggle}">
      <Setter Property="LayoutTransform">
        <Setter.Value>
          <ScaleTransform ScaleX="0.74" ScaleY="0.74" />
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
      <Setter Property="Padding" Value="20,8" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="FloatingCloseButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.65" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TrayMoreButtonStyle" TargetType="Button" BasedOn="{StaticResource FooterCircleButtonStyle}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <controls:CircleButtonBorder Background="{TemplateBinding Background}" CornerRadius="18" />
              <Border x:Name="CircleHover" Margin="0.75" Background="#28FFFFFF" CornerRadius="17.25" Opacity="0" IsHitTestVisible="False" />
              <Border x:Name="CirclePressed" Margin="0.75" Background="{DynamicResource FooterPressedBrush}" CornerRadius="17.25" Opacity="0" IsHitTestVisible="False" />
              <controls:CircleButtonBorder Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" IsHitTestVisible="False" />
              <controls:CircleButtonBorder x:Name="CircleHoverOutline" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Opacity="0" IsHitTestVisible="False" />
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="CircleHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                      <DoubleAnimation Storyboard.TargetName="CircleHoverOutline" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.1" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="CircleHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                      <DoubleAnimation Storyboard.TargetName="CircleHoverOutline" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="CircleHover" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="CirclePressed" Property="Opacity" Value="1" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="CircleHover" Property="Opacity" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="IconRowTemplate">
      <Grid Height="34" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="28" />
          <ColumnDefinition />
          <ColumnDefinition Width="46" />
          <ColumnDefinition Width="28" />
        </Grid.ColumnDefinitions>
        <tray:TrayIconButton Width="28" Height="28" MinWidth="0" MinHeight="0" ImageSource="{Binding Image}" Tag="{Binding}" NativeAction="IconNativeAction" VerticalAlignment="Center" AutomationProperties.AutomationId="TrayNativeAction" AutomationProperties.Name="{Binding Name}" />
        <TextBlock Grid.Column="1" Margin="8,0,8,0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <controls:SwitchControl Grid.Column="2" Style="{StaticResource TrayRowToggle}" Margin="0,0,8,0" IsChecked="{Binding Visible,Mode=OneWay}" IsEnabled="{Binding CanToggle}" Tag="{Binding}" Click="VisibilityClick" AutomationProperties.AutomationId="TrayVisibility" AutomationProperties.Name="{Binding Name}" />
        <Button Grid.Column="3" Style="{StaticResource TrayMoreButtonStyle}" Width="28" Height="28" MinWidth="0" MinHeight="0" Tag="{Binding}" Click="IconSettingsClick" VerticalAlignment="Center" AutomationProperties.AutomationId="IconSettings" AutomationProperties.Name="图标设置">
          <TextBlock Text="" FontFamily="{StaticResource AppIconFont}" FontSize="12" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" controls:GlyphInkAlignment.Enabled="True" />
        </Button>
        <Border Grid.Column="1" Grid.ColumnSpan="3" Height="0.5" Margin="8,0,0,0" Background="{DynamicResource BorderBrush}" VerticalAlignment="Bottom" IsHitTestVisible="False" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <AdornerDecorator>
    <Grid x:Name="PageRoot">
      <Grid x:Name="PageContent">
        <Grid.RowDefinitions>
          <RowDefinition Height="48" />
          <RowDefinition />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:SegmentedControl x:Name="Navigation" Margin="14,6,14,6" Height="36" SelectedIndex="0" SelectionChanged="Navigate" AutomationProperties.AutomationId="Navigation" AnimationMilliseconds="480" FontSize="14">
          <controls:SegmentItem x:Name="NavIcons" Tag="icons" AutomationProperties.AutomationId="NavIcons">
            <TextBlock Text="托盘图标" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=controls:SegmentItem}}" />
          </controls:SegmentItem>
          <controls:SegmentItem x:Name="NavSystem" Tag="system" AutomationProperties.AutomationId="NavSystem">
            <TextBlock Text="系统图标" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=controls:SegmentItem}}" />
          </controls:SegmentItem>
          <controls:SegmentItem x:Name="NavSettings" Tag="settings" AutomationProperties.AutomationId="NavSettings">
            <TextBlock Text="设置" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=controls:SegmentItem}}" />
          </controls:SegmentItem>
        </controls:SegmentedControl>
        <Grid Grid.Row="1" Margin="14,-6,0,0" x:Name="PagesHost" ClipToBounds="True">
          <ListBox x:Name="IconList" Style="{StaticResource DeviceListBoxStyle}" ItemsSource="{Binding Icons}" ItemTemplate="{StaticResource IconRowTemplate}" AllowDrop="True" SelectionMode="Single" PreviewMouseLeftButtonDown="DragStarting" PreviewMouseMove="DragMoving" DragOver="DragOverRow" Drop="DropRow" AutomationProperties.AutomationId="TrayIconList">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem" BasedOn="{StaticResource TrayListItemStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Focusable" Value="False" />
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
          <ScrollViewer x:Name="LoadingList" Style="{StaticResource DeviceListScrollViewerStyle}" IsHitTestVisible="False" AutomationProperties.AutomationId="TrayLoadingPlaceholders">
            <StackPanel x:Name="LoadingRows" />
          </ScrollViewer>
          <ScrollViewer x:Name="SystemView" Visibility="Collapsed" Style="{StaticResource FadingDetailScrollViewerStyle}" controls:DeviceListViewport.Enabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="SystemScroll">
            <StackPanel Margin="0,12,0,0">
              <controls:RoundedCardBorder Style="{StaticResource SettingsCard}">
                <StackPanel>
                  <StackPanel x:Name="SystemList" />
                </StackPanel>
              </controls:RoundedCardBorder>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" Style="{StaticResource FadingDetailScrollViewerStyle}" controls:DeviceListViewport.Enabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="SettingsScroll">
            <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel Margin="0,12,0,0">
                <controls:RoundedCardBorder Style="{StaticResource SettingsCard}">
                  <StackPanel>
                    <Grid Margin="0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock Text="开机启动" />
                      </StackPanel>
                      <controls:SwitchControl Grid.Column="1" IsChecked="{Binding Startup,Mode=TwoWay}" AutomationProperties.AutomationId="StartupToggle" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,5" />
                    <Grid Margin="0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock Text="主题" />
                      </StackPanel>
                      <ComboBox x:Name="ThemeChoice" Grid.Column="1" Width="150" SelectedIndex="{Binding ThemeIndex,Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.AutomationId="ThemeChoice" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,5" />
                    <Grid Margin="0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock Text="语言" />
                      </StackPanel>
                      <ComboBox x:Name="LanguageChoice" Grid.Column="1" Width="150" SelectedIndex="{Binding LanguageIndex,Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.AutomationId="LanguageChoice" />
                    </Grid>
                  </StackPanel>
                </controls:RoundedCardBorder>
                <controls:RoundedCardBorder Style="{StaticResource SettingsCard}">
                  <StackPanel>
                    <TextBlock Text="高级设置" Style="{StaticResource DetailSectionTitleStyle}" Margin="0,10,0,12" />
                    <WrapPanel Margin="0,0,0,10">
                      <Button Content="导出配置…" Click="ExportClick" Margin="0,0,8,0" />
                      <Button Content="导入配置…" Click="ImportClick" />
                    </WrapPanel>
                  </StackPanel>
                </controls:RoundedCardBorder>
              </StackPanel>
              <TextBlock x:Name="VersionText" Grid.Row="2" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,8,0,16" AutomationProperties.AutomationId="SoftwareVersion" />
            </Grid>
          </ScrollViewer>
        </Grid>
        <controls:RoundedCardBorder x:Name="ErrorNotice" Grid.Row="2" Style="{StaticResource CardStyle}" Visibility="Collapsed" Margin="14,0,14,12" Background="{DynamicResource DangerSurfaceBrush}" AutomationProperties.AutomationId="OperationError">
          <StackPanel>
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <Button Content="重试" Command="{Binding ReconnectCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </controls:RoundedCardBorder>
      </Grid>
      <Grid x:Name="FloatingLayer" Panel.ZIndex="100" Background="#38000000" Visibility="Collapsed" MouseDown="FloatingBackgroundDown" KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.AutomationId="FloatingLayer">
        <controls:RoundedCardBorder x:Name="FloatingCard" Background="{DynamicResource FloatingSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="24" Padding="20" Margin="16" MaxWidth="420" HorizontalAlignment="Stretch" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
          <controls:RoundedCardBorder.RenderTransform>
            <TransformGroup>
              <ScaleTransform x:Name="FloatingScale" />
              <TranslateTransform x:Name="FloatingTranslate" />
            </TransformGroup>
          </controls:RoundedCardBorder.RenderTransform>
          <ContentControl x:Name="FloatingContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </controls:RoundedCardBorder>
      </Grid>
    </Grid>
  </AdornerDecorator>
</UserControl>